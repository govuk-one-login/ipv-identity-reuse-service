{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}

{% extends "govuk/template.njk" %}
{% block head %}
    <link rel="stylesheet" href="{{ rootPath | default("", true) }}/govuk-frontend.min.css">
    <base href="./error/session-expired" />
{% endblock %}

{% block pageTitle %}{{ translations.pages.sessionExpired.title }}{% endblock %}
{% block beforeContent %}
    {{ govukPhaseBanner({
        tag: {
            text: translations.betaBanner.tag
        },
        html: translations.betaBanner.content
    }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ translations.pages.sessionExpired.header }}</h1>
      <h2 class="govuk-heading-m">{{ translations.pages.sessionExpired.content.subHeading }}</h2>
      <p class="govuk-body">{{ translations.pages.sessionExpired.content.paragraph1 }}</p>

      {{ govukButton({
        "text": translations.pages.sessionExpired.content.govUkHomepageButtonText,
        "type": "Submit",
        "href": translations.pages.sessionExpired.content.govUkHomepageButtonLink
      }) }}

      <p class="govuk-body"><a class="govuk-link" href="{{ translations.pages.sessionExpired.content.oneLoginContactLink }}" target="_blank">{{ translations.pages.sessionExpired.content.oneLoginContactLinkText }}</a></p>
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  {# Run JavaScript at end of the <body>, to avoid blocking the initial render. #}
  <script type="module" src="{{ rootPath | default("", true) }}/govuk-frontend.min.js"></script>
  <script type="module">
      import { initAll } from '{{ rootPath | default("", true) }}/govuk-frontend.min.js'
      initAll()
  </script>
  <script type="module" src="{{ rootPath | default("", true) }}/frontend-ui.js"></script>
{% endblock %}
