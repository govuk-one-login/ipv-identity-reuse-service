{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "@govuk-one-login/frontend-ui/build/components/phase-banner/macro.njk" import frontendUiPhaseBanner %}
{% from "@govuk-one-login/frontend-ui/build/components/progress-button/macro.njk" import frontendUiProgressButton %}

{% extends "govuk/template.njk" %}
{% block head %}
    <link rel="stylesheet" href="{{ rootPath | default("", true) }}/govuk-frontend.min.css">
    <base href="./confirm-details" />
    <style {% if cspNonce %} nonce="{{ cspNonce }}"{%  endif %}>
        .govuk-button-as-link {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            font: inherit;
            cursor: pointer;
            vertical-align: baseline;
        }

        .govuk-button-as-link:focus {
                    outline: 3px solid transparent;
                    color: #0b0c0c;
                    background-color: #fd0;
                    box-shadow: 0 -2px #fd0, 0 4px #0b0c0c;
                    text-decoration: none;
        }
    </style>
{% endblock %}

{% block pageTitle %}{{ translations.pages.confirmDetails.title }}{% endblock %}
{% block beforeContent %}
    {{ frontendUiPhaseBanner({
        translations: translations.phaseBanner,
        url: currentUrl,
        contactUrl: 'https://signin.account.gov.uk/contact-us',
        noAppend: false
    }) }}

{% endblock %}
{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">{{ translations.pages.confirmDetails.header }}</h1>

            <p class="govuk-body">{{ translations.pages.confirmDetails.content.paragraph1 }}</p>

            {% set rows = [
                {
                    key: {
                        text: translations.pages.confirmDetails.content.userDetailsInformation.fullName
                    },
                    value: {
                        text: userDetails.name
                    }
                }
            ] %}

            {% if userDetails.addressDetailHtml %}
                {% set rows = (rows.push({
                    key: {
                        text: translations.pages.confirmDetails.content.userDetailsInformation.currentAddress
                    },
                    value: {
                        html: userDetails.addressDetailHtml
                    }
                }), rows) %}
            {% endif %}

            {% set rows = (rows.push({
                key: {
                    text: translations.pages.confirmDetails.content.userDetailsInformation.dateOfBirth
                },
                value: {
                    text: userDetails.dateOfBirth | GDSDate
                }
            }), rows) %}

            {{ govukSummaryList({
                rows: rows
            }) }}

            <p class="govuk-body">{{ translations.pages.confirmDetails.content.paragraph2 }}</p>

            {% set detailsHtml %}
                <p class="govuk-body"><strong>{{ translations.pages.confirmDetails.content.updateUserDetailsInformation.detailsChangedHeading }}</strong></p>
                <p class="govuk-body">{{ translations.pages.confirmDetails.content.updateUserDetailsInformation.detailsChangedParagraph1 }}</p>
                <p class="govuk-body">{{ translations.pages.confirmDetails.content.updateUserDetailsInformation.detailsChangedParagraph2 }}</p>
                <p class="govuk-body">{{ translations.pages.confirmDetails.content.updateUserDetailsInformation.detailsChangedParagraph3 }}</p>
                <p class="govuk-body">{{ translations.pages.confirmDetails.content.updateUserDetailsInformation.detailsChangedText }} <button type="submit" form="submitForm" name="action" value="update-details" class="govuk-link govuk-button-as-link">{{ translations.pages.confirmDetails.content.updateUserDetailsInformation.detailsChangedLinkText }}</button>.</p>
                <p class="govuk-body govuk-!-margin-top-6"><strong>{{ translations.pages.confirmDetails.content.updateUserDetailsInformation.nameMistakeHeading }}</strong></p>
                <p class="govuk-body"><a class="govuk-link" href="{{ translations.pages.confirmDetails.content.updateUserDetailsInformation.oneLoginSupportLinkUrl }}" target="_blank">{{ translations.pages.confirmDetails.content.updateUserDetailsInformation.nameMistakeParagraph1LinkText }}</a> {{ translations.pages.confirmDetails.content.updateUserDetailsInformation.nameMistakeParagraph1 }}</p>
                <p class="govuk-body">{{ translations.pages.confirmDetails.content.updateUserDetailsInformation.nameMistakeParagraph2 }}</p>
            {% endset %}

            {{ govukDetails({
                summaryText: translations.pages.confirmDetails.content.updateUserDetailsInformation.updateDetailsLabel,
                html: detailsHtml
            }) }}

            <form id="submitForm" action="/confirm-details" method="post">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                {{ frontendUiProgressButton({
                    id: "submitButton",
                    name: "action",
                    value: "continue",
                    translations: translations.progressButton,
                    text: translations.pages.confirmDetails.content.continueButton,
                    element: "button",
                    errorPage: "/error/unrecoverable"
                }) }}
            </form>
        </div>
    </div>
{% endblock %}

{% block bodyEnd %}
{# Run JavaScript at end of the <body>, to avoid blocking the initial render. #}
<script type="module" src="{{ rootPath | default("", true) }}/govuk-frontend.min.js"></script>
<script type="module" {% if cspNonce %}nonce="{{ cspNonce }}"{%  endif %}>
    import { initAll } from '{{ rootPath | default("", true) }}/govuk-frontend.min.js'
    initAll()
</script>
<script type="module" src="{{ rootPath | default("", true) }}/frontend-ui.js"></script>
<script type="module" {% if cspNonce %}nonce="{{ cspNonce }}"{%  endif %}>
    import { useSpinner } from '{{ rootPath | default("", true) }}/frontend-ui.js'
    useSpinner()
</script>
{% endblock %}
