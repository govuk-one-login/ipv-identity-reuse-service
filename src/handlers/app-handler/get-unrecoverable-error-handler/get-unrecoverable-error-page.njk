{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% extends basePageTemplate %}

{% block pageTitle %}{{ translations.pages.unrecoverable.title }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors and errors.length > 0 %}
        {{ govukErrorSummary({
            "titleText": "Error",
            "errorList":  errors
        }) }}
      {% endif %}

      <h1 class="govuk-heading-l">{{ translations.pages.unrecoverable.header }}</h1>
      <p class="govuk-body">{{ translations.pages.unrecoverable.content.paragraph1 }}</p>
      <h2 class="govuk-heading-m">{{ translations.pages.unrecoverable.content.subHeading }}</h2>
      <p class="govuk-body">{{ translations.pages.unrecoverable.content.paragraph2 }}</p>

      {{ govukButton({
        "text": translations.pages.unrecoverable.content.govUkHomepageButtonText,
        "type": "Submit",
        "href": translations.pages.unrecoverable.content.govUkHomepageButtonLink
      }) }}

      <p class="govuk-body">
        <a class="govuk-link" href="{{ translations.pages.unrecoverable.content.oneLoginContactLink }}" target="_blank">{{ translations.pages.unrecoverable.content.oneLoginContactLinkText }}</a>
      </p>
    </div>
  </div>
{% endblock %}
